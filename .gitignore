# OS
.DS_Store
Thumbs.db

# 依存・ビルド生成物
node_modules/
dist/
build/
.next/
*.log

# 機密（コミット禁止）
.env
.env.*
*.pem
*.p12
*.key
*credentials*
*secrets*
# ソースコードは対象外（認証まわりのファイル名で誤って除外されないように）
!src/**/*credentials*
!src/**/*secrets*

# Claude ローカル設定
.claude/settings.local.json

# 環境変数の例はコミットする
!.env.example

# Next.js・TypeScript・テストの生成物
/out/
/coverage
next-env.d.ts
*.tsbuildinfo
.vercel
.pnpm-debug.log*

# Prisma Client の生成物（pnpm install 時の postinstall / pnpm db:generate で作る）
/src/generated/prisma
