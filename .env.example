# ローカル開発用の例（compose.yaml の値に合わせてある）。コピーして .env を作る: cp .env.example .env
# ※ ローカル専用のダミー値。本番の接続情報はここに書かない

# 開発用 DB
DATABASE_URL="postgresql://stockflow:stockflow@localhost:54329/stockflow?schema=public"
# テスト用 DB（結合テストで使う）
DATABASE_URL_TEST="postgresql://stockflow:stockflow@localhost:54329/stockflow_test?schema=public"
# マイグレーション（Prisma CLI）用の直接接続の URL。本番（Neon）では DATABASE_URL にプール接続（-pooler）の URL、
# ここに直接接続の URL を設定する（docs/deploy.md）。空なら Prisma CLI も DATABASE_URL を使う（ローカルは空のまま）
DIRECT_URL=""

# 認証（Better Auth）。ローカル用のダミー値。本番では `openssl rand -base64 32` などで生成した値に置き換える
BETTER_AUTH_SECRET="local-dev-dummy-secret-do-not-use-in-production"
# アプリの URL（ログインの Cookie・リダイレクトの基準。発注点割れの通知の在庫画面へのリンクにも使う）
BETTER_AUTH_URL="http://localhost:3000"

# 発注点割れの通知（Slack Incoming Webhook の URL。https のみ）。空なら通知しない（デモは空のまま）
STOCKFLOW_SLACK_WEBHOOK_URL=""

# 本番（デモ環境）だけで使う値。ローカルは空のまま（docs/deploy.md）
# 日次リセットの Cron（GET /api/cron/reset-demo）の認証。Vercel が Cron の呼び出しに `Authorization: Bearer <この値>` を付ける。
# 本番では `openssl rand -base64 32` などで生成する。空なら /api/cron/reset-demo は常に 401
CRON_SECRET=""
# 1 にすると、ローカル以外の DB のデータを消去する操作（シード・日次リセット）を許可する（scripts/db-guard.ts）。
# 本番（デモ環境）でだけ 1 にする
STOCKFLOW_ALLOW_DESTRUCTIVE_SEED=""
